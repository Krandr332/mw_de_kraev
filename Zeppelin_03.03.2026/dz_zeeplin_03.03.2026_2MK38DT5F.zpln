    {
      "text": "%spark.pyspark\r\n\r\ncity_product_st = ord_enri.groupBy(\r\n    \"city\", \"product_id\", \"product_name\"\r\n).agg(\r\n    F.count(\"order_id\").alias(\"orders_cnt\"),\r\n    F.sum(\"qty\").alias(\"qty_sum\"),\r\n    F.sum(\"revenue\").alias(\"revenue_sum\")\r\n)\r\ncity_product_st.show()",
