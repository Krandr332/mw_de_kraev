    {
      "text": "%spark.pyspark\r\n\r\nfrom pyspark.sql.window import Window\r\n\r\nwindow_spec = Window.partitionBy(\"city\").orderBy(F.col(\"revenue_sum\").desc())\r\ncity_product_st = city_product_st.withColumn(\r\n    \"time_top\", F.row_number().over(window_spec))\r\ntop_products = city_product_st.filter(F.col(\"time_top\") <= 2).drop(\"time_top\")\r\ntop_products.show()",
