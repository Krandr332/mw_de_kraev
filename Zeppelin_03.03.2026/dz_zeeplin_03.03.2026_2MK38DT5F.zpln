        "code": "SUCCESS",
        "msg": []
      }
    },
    {
      "text": "%spark.pyspark\r\n\r\nfrom pyspark.sql import functions as F\r\nusers = spark.createDataFrame(\r\n[ (\"u1\", \"Berlin\"),\r\n(\"u2\", \"Berlin\"),\r\n(\"u3\", \"Munich\"),\r\n(\"u4\", \"Hamburg\"), ],\r\n[\"user_id\", \"city\"] )\r\norders = spark.createDataFrame(\r\n[ (\"o1\", \"u1\", \"p1\", 2, 10.0),\r\n(\"o2\", \"u1\", \"p2\", 1, 30.0),\r\n(\"o3\", \"u2\", \"p1\", 1, 10.0),\r\n(\"o4\", \"u2\", \"p3\", 5, 7.0),\r\n(\"o5\", \"u3\", \"p2\", 3, 30.0),\r\n(\"o6\", \"u3\", \"p3\", 1, 7.0),\r\n(\"o7\", \"u4\", \"p1\", 10, 10.0), ],\r\n[\"order_id\", \"user_id\", \"product_id\", \"qty\", \"price\"] )\r\nproducts = spark.createDataFrame(\r\n[ (\"p1\", \"Ring VOLA\"),\r\n(\"p2\", \"Ring POROG\"),\r\n(\"p3\", \"Ring TISHINA\"), ],\r\n[\"product_id\", \"product_name\"] )\r\nusers.show() \r\norders.show()\r\nproducts.show()\r\n",
      "user": "anonymous",
      "dateUpdated": "2026-02-28T22:18:52+0000",
      "progress": 0,
